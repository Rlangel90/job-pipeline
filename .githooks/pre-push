#!/bin/sh
# Last line of defence before anything becomes public: scan every tracked file and every
# commit message that is about to be pushed.
set -e
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  python tools/guard_terms.py --tree "$local_sha" || status=1
  case "$remote_sha" in
    0000000000000000000000000000000000000000) range="$local_sha" ;;
    *) range="$remote_sha..$local_sha" ;;
  esac
  python tools/guard_terms.py --log "$range" || status=1
done
exit $status
